{
	"files.autoSave": "onFocusChange",
	// Git
	"git.autofetch": true,
	"git.confirmSync": false,
	// Editor
	"editor.defaultFormatter": "biomejs.biome",
	"editor.tabSize": 2,
	"editor.formatOnSave": true,
	"editor.insertSpaces": true,
	"editor.fontFamily": "'MonoLisa', 'FiraCode Nerd Font Mono', 'Cartograph CF', Menlo, Monaco, 'Courier New', monospace",
	"editor.bracketPairColorization.independentColorPoolPerBracketType": true,
	"editor.bracketPairColorization.enabled": true,
	"editor.guides.bracketPairs": "active",
	"editor.guides.bracketPairsHorizontal": true,
	"editor.minimap.enabled": false,
	//Terminal
	"terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
	"terminal.integrated.profiles.osx": {
		"fish": { "path": "/opt/homebrew/bin/fish" }
	},
	"terminal.integrated.defaultProfile.osx": "fish",
	// Workbench
	"workbench.activityBar.location": "top",
	"workbench.startupEditor": "none",
	"workbench.iconTheme": "catppuccin-macchiato",
	// Copilot
	"github.copilot.nextEditSuggestions.enabled": true,
	"github.copilot.chat.codesearch.enabled": true,
	"github.copilot.chat.completionContext.typescript.mode": "on",
	"github.copilot.chat.editor.temporalContext.enabled": true,
	"github.copilot.chat.edits.temporalContext.enabled": true,
	"github.copilot.chat.languageContext.fix.typescript.enabled": true,
	"github.copilot.chat.languageContext.inline.typescript.enabled": true,
	"github.copilot.chat.languageContext.typescript.enabled": true,
	// Vim
	"vim.leader": ",",
	"vim.highlightedyank.enable": true,
	"vim.smartcase": true,
	"vim.ignorecase": true,
	"vim.useSystemClipboard": true,
	"vim.easymotion": true,
	"vim.hlsearch": true,
	"vim.normalModeKeyBindings": [
		{
			"before": ["<C-j>"],
			"after": ["5", "j"]
		},
		{
			"before": ["<C-k>"],
			"after": ["5", "k"]
		},
		{
			"before": ["<Esc><Esc>"],
			"commands": [
				{
					"command": ":noh"
				}
			]
		},
		{
			"before": ["<leader>", "r"],
			"commands": [
				{
					"command": "editor.action.rename"
				}
			]
		},
		{
			"before": ["<space>"],
			"after": ["/"]
		}
	],
	"vim.visualModeKeyBindings": [
		{
			"before": ["<C-j>"],
			"after": ["5", "j"]
		},
		{
			"before": ["<C-k>"],
			"after": ["5", "k"]
		}
	],
	"vim.insertModeKeyBindings": [
		{
			"before": ["j", "j"],
			"after": ["<Esc>"]
		}
	],
	"biome.suggestInstallingGlobally": false,
	"terminal.integrated.suggest.enabled": true,
	"redhat.telemetry.enabled": false,
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true
	},
	"[toml]": {
		"editor.defaultFormatter": "tamasfe.even-better-toml"
	},
	"[dockercompose]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"[github-actions-workflow]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"editor.fontLigatures": true,
	"chat.mcp.gallery.enabled": true,
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"editor.aiStats.enabled": true,
	"editor.inlayHints.enabled": "off",
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": true,
		"scminput": false
	},
	"chat.useNestedAgentsMdFiles": true,
	"chat.viewSessions.orientation": "stacked",
	"chat.viewSessions.enabled": false,
	"workbench.colorTheme": "Old World Dark",
	"terminal.integrated.fontLigatures.enabled": true,
	"sonarlint.connectedMode.connections.sonarcloud": [
		{
			"organizationKey": "enturas-github",
			"connectionId": "enturas-github",
			"region": "EU"
		}
	],
	"json.schemaDownload.trustedDomains": {
		"https://biomejs.dev": true,
		"https://developer.microsoft.com/json-schemas/": true,
		"https://github.com/IBM/audit-ci/raw/main/docs/schema.json": true,
		"https://json-schema.org/": true,
		"https://json.schemastore.org/": true,
		"https://raw.githubusercontent.com/": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://schemastore.azurewebsites.net/": true,
		"https://turbo.build/schema.json": true,
		"https://unpkg.com": true,
		"https://www.schemastore.org/": true
	},
	"claudeCode.preferredLocation": "panel",
	"diffEditor.ignoreTrimWhitespace": false,
	"yaml.disableSchemaDetection": [
		"**/.github/workflows/*.yml",
		"**/.github/workflows/*.yaml",
		"**/.gitea/workflows/*.yml",
		"**/.gitea/workflows/*.yaml",
		"**/.forgejo/workflows/*.yml",
		"**/.forgejo/workflows/*.yaml"
	],
	"intellij.region": "europe",
	"intellij.dataSharing": "none",
	"workbench.experimental.modernUI": true,
	"mise.binPath": "/opt/homebrew/bin/mise"
}
