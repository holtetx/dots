{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.17"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "mh-spaces"
          }
        },
        {
          "id": "footer",
          "type": "block",
          "content": {
            "mod": "mh-footer"
          },
          "size": {
            "px": 26
          }
        }
      ],
      "size": {
        "px": 308
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "radius": 12,
      "border": {
        "width": 1,
        "color": "border"
      }
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "mh-tabs"
          },
          "size": {
            "px": 32
          },
          "window_drag": true,
          "background": "chrome",
          "radius": 12,
          "border": {
            "width": 1,
            "color": "border"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "veil": 0.3,
                  "radius": 12,
                  "gap": 8,
                  "lone": true,
                  "header": {
                    "content": {
                      "mod": "mh-pane"
                    },
                    "height": 36,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "checks",
                      "type": "block",
                      "content": {
                        "mod": "mh-spaces",
                        "props": {
                          "checks": true
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "focus": {
                "border": {
                  "width": 1,
                  "color": "accent"
                }
              },
              "background": "chrome",
              "radius": 12,
              "border": {
                "width": 1,
                "color": "border"
              }
            }
          ],
          "padding": 0,
          "gap": 8
        },
        {
          "id": "git",
          "type": "block",
          "content": {
            "mod": "mh-spaces",
            "props": {
              "bar": true
            }
          },
          "size": {
            "px": 26
          },
          "background": "chrome",
          "radius": 12,
          "border": {
            "width": 1,
            "color": "border"
          }
        }
      ],
      "resizable": false,
      "gap": 8
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    16,
    14
  ],
  "titlebar": "none",
  "traffic_lights": [
    -100,
    -100
  ],
  "terminal_menu": "mh-menu",
  "toast": "mh-toast",
  "theme": "pixel-hq",
  "font": "JetBrains Mono",
  "ui_font": "JetBrains Mono",
  "padding": 8,
  "gap": 8
}
