    "cmd-]": "mh-tabs.agent-next",
    "cmd-[": "mh-tabs.agent-prev",
    "cmd-ctrl-[": { "command": "tab.move", "args": { "by": -1 } },
    "cmd-ctrl-]": { "command": "tab.move", "args": { "by": 1 } },
