    "cmd-3": "tab.select:3",
    "cmd-4": "tab.select:4",
    "cmd-5": "tab.select:5",
    "cmd-6": "tab.select:6",
    "cmd-7": "tab.select:7",
    "cmd-8": "tab.select:8",
    "cmd-9": "tab.select:9",
    "ctrl-1": "mh-tabs.space-1",
    "ctrl-2": "mh-tabs.space-2",
    "ctrl-3": "mh-tabs.space-3",
    "ctrl-4": "mh-tabs.space-4",
    "ctrl-5": "mh-tabs.space-5",
    "ctrl-6": "mh-tabs.space-6",
    "ctrl-7": "mh-tabs.space-7",
    "ctrl-8": "mh-tabs.space-8",
    "ctrl-9": "mh-tabs.space-9",
    "cmd-shift-c": "mh-spaces.new-session",
