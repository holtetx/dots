      "args": {
        "name": "Claude",
        "argv": [
          "claude",
          "--worktree"
        ]
      }
    },
    "cmd-shift-n": "mh-tabs.new-window",
    "cmd-k": "mod.open:mh-sessions",
    "cmd-o": "mod.open:mh-open",
    "alt-n": "tab.next",
    "alt-p": "tab.prev",
    "alt-shift-n": "mh-tabs.space-next",
    "alt-shift-p": "mh-tabs.space-prev",
    "alt-h": "pane.go:left",
